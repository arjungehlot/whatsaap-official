{
  "name": "wacrm-node-backend",
  "version": "1.0.0",
  "private": true,
  "description": "MongoDB and Express backend for wacrm",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node src/scripts/check.js",
    "migrate:message-id-index": "node src/scripts/repair-message-id-index.js",
