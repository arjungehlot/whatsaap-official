PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=https://waflow360.in,https://www.waflow360.in,https://api.waflow360.in,http://localhost:3000,http://localhost:5173
ALLOW_NULL_ORIGIN=false
SUPER_ADMIN_EMAILS=admin@example.com
PAYU_KEY=
PAYU_SALT=
PAYU_BASE_URL=https://test.payu.in/_payment
PAYU_VERIFY_URL=https://test.payu.in/merchant/postservice.php?form=2
PAYU_VERIFY_TIMEOUT_MS=15000
PAYU_CHECKOUT_COOLDOWN_MS=60000
PAYU_SUCCESS_URL=http://localhost:5000/api/billing/payu/callback
PAYU_FAILURE_URL=http://localhost:5000/api/billing/payu/callback
PAYU_FRONTEND_SUCCESS_URL=http://localhost:8080/pricing?payment=success
PAYU_FRONTEND_FAILURE_URL=http://localhost:8080/pricing?payment=failed
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d
MAX_WHATSAPP_DEVICES=3
MONGO_URI=mongodb://127.0.0.1:27017/whatsapp-unofficial
WHATSAPP_SEND_MIN_DELAY_MS=3000
WHATSAPP_SEND_MAX_DELAY_MS=12000
WHATSAPP_TYPING_MIN_DELAY_MS=800
WHATSAPP_TYPING_MAX_DELAY_MS=2500
WHATSAPP_HOURLY_SEND_CAP=120
WHATSAPP_DAILY_SEND_CAP=1000
WHATSAPP_WARMUP_DAYS=14
WHATSAPP_WARMUP_HOURLY_SEND_CAP=60
WHATSAPP_WARMUP_DAILY_SEND_CAP=500
WHATSAPP_WARMUP_MIN_DELAY_MS=8000
WHATSAPP_WARMUP_MAX_DELAY_MS=25000
WHATSAPP_MESSAGE_SEND_TIMEOUT_MS=90000
WHATSAPP_GROUP_OPERATION_TIMEOUT_MS=15000
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
AWS_S3_BUCKET=smartitbox.bucket
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_UPLOAD_TIMEOUT_MS=30000
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
